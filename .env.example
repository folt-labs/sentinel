# ServerGuard Environment Variables

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=serverguard
DATABASE_PASSWORD=serverguard
DATABASE_NAME=serverguard

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secret (change in production!)
JWT_SECRET=change-this-in-production-use-a-secure-random-string

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@serverguard.local

# API URL (for dashboard)
API_URL=http://localhost:8080
