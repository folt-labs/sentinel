{
    auto_https off
}

:443 {
    tls /etc/ssl/cloudflare/cert.pem /etc/ssl/cloudflare/key.pem

    @dashboard host {$DOMAIN}
    handle @dashboard {
        reverse_proxy dashboard:3000
    }

    @api host {$API_DOMAIN}
    handle @api {
        reverse_proxy api:8080
    }
}

:80 {
    redir https://{host}{uri} permanent
}
